<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Happy Birthday, Siddhi! 🎂</title>
    <link rel="stylesheet" href="style.css">
</head>
<body>

    <main class="birthday-page">
        <div class="stars" aria-hidden="true"></div>

        <section class="birthday-card">
            <p class="eyebrow">✨ TODAY IS ALL ABOUT YOU ✨</p>

            <span class="cake-emoji" role="img" aria-label="Birthday cake">
                🎂
            </span>

            <h1 class="birthday-title">
                Happy<br>Birthday
                <span class="birthday-name">Siddhi Mankar!</span>
            </h1>

            <p class="birthday-subtitle">
                Another year older, another year more fabulous!
                Today deserves extra cake, unlimited smiles,
                and a little birthday magic. 💖
            </p>

            <button
                class="primary-button"
                type="button"
                onclick="window.location.href='gift.jsp'">
                Let the fun begin! 🎁
            </button>

            <p class="footer-note">
                Made with ❤️ by your favourite brother
            </p>
        </section>
    </main>

</body>
</html>
